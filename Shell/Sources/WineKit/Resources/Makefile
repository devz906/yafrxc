dlls/vcomp/main.o: dlls/vcomp/main.c
	$(CC) -c -o $@ dlls/vcomp/main.c -Idlls/vcomp -Iinclude -Iinclude/msvcrt -D_UCRT -D__WINESRC__ \
  -D__WINE_PE_BUILD -Wall -pipe -fcf-protection=none -fno-stack-protector -fno-strict-aliasing \
  -Wdeclaration-after-statement -Wempty-body -Wignored-qualifiers -Winit-self -Wno-pragma-pack \
  -Wstrict-prototypes -Wtype-limits -Wunused-but-set-parameter -Wvla -Wwrite-strings -Wpointer-arith \
  -gdwarf-4 -fasynchronous-unwind-tables $(CFLAGS)
dlls/vcomp/main.o: include/msvcrt/stdarg.h include/msvcrt/vadefs.h include/msvcrt/corecrt.h \
