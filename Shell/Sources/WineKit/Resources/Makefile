	STRIPPROG="$(STRIP)" tools/install-sh $(INSTALL_PROGRAM_FLAGS) dlls/ucrtbase/ucrtbase.dll $(DESTDIR)$(dlldir)/ucrtbase.dll
dlls/ucrtbase/install dlls/ucrtbase/install-dev:: dlls/ucrtbase/libucrtbase.a
	tools/install-sh -m 644 $(INSTALL_DATA_FLAGS) dlls/ucrtbase/libucrtbase.a $(DESTDIR)$(dlldir)/libucrtbase.a
