  dlls/advapi32/libadvapi32.a dlls/winecrt0/libwinecrt0.a dlls/ucrtbase/libucrtbase.a \
  dlls/kernel32/libkernel32.a dlls/ntdll/libntdll.a /build/tools/winebuild/winebuild \
  /build/tools/winegcc/winegcc
	/build/tools/winegcc/winegcc -o $@ --wine-objdir . --winebuild /build/tools/winebuild/winebuild -b \
  aarch64-w64-mingw32 -mno-cygwin -fasynchronous-unwind-tables -shared dlls/faultrep/faultrep.spec \
  -Wb,--prefer-native dlls/faultrep/faultrep.o dlls/advapi32/libadvapi32.a \
  dlls/winecrt0/libwinecrt0.a dlls/ucrtbase/libucrtbase.a dlls/kernel32/libkernel32.a \
  dlls/ntdll/libntdll.a $(LDFLAGS)
