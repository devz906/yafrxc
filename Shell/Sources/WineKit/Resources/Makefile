programs/arp/main.o: programs/arp/main.c
	$(CC) -c -o $@ programs/arp/main.c -Iprograms/arp -Iinclude -Iinclude/msvcrt -D_UCRT -D__WINESRC__ \
  -D__WINE_PE_BUILD -Wall -pipe -fcf-protection=none -fno-stack-protector -fno-strict-aliasing \
  -Wdeclaration-after-statement -Wempty-body -Wignored-qualifiers -Winit-self -Wno-pragma-pack \
  -Wstrict-prototypes -Wtype-limits -Wunused-but-set-parameter -Wvla -Wwrite-strings -Wpointer-arith \
  -gdwarf-4 -fasynchronous-unwind-tables $(CFLAGS)
programs/arp/main.o: include/wine/debug.h include/msvcrt/stdarg.h include/msvcrt/vadefs.h \
  include/msvcrt/corecrt.h include/sal.h include/msvcrt/stdio.h include/msvcrt/corecrt_wstdio.h \
  include/msvcrt/corecrt_stdio_config.h include/pshpack8.h include/poppack.h include/windef.h \
  include/winnt.h include/basetsd.h include/guiddef.h include/msvcrt/string.h \
  include/msvcrt/corecrt_malloc.h include/msvcrt/corecrt_wstring.h include/winapifamily.h \
  include/specstrings.h include/driverspecs.h include/concurrencysal.h include/msvcrt/ctype.h \
  include/msvcrt/corecrt_wctype.h include/msvcrt/stddef.h include/msvcrt/intrin.h include/excpt.h \
  include/pshpack4.h include/winnt.rh include/pshpack2.h include/pshpack1.h include/winbase.h \
  include/winerror.h include/libloaderapi.h include/processthreadsapi.h include/synchapi.h \
  include/threadpoolapiset.h include/memoryapi.h include/realtimeapiset.h include/namespaceapi.h \
  include/timezoneapi.h
programs/arp/arp.exe: programs/arp/main.o dlls/winecrt0/libwinecrt0.a dlls/ucrtbase/libucrtbase.a \
  dlls/kernel32/libkernel32.a dlls/ntdll/libntdll.a /build/tools/winebuild/winebuild \
  /build/tools/winegcc/winegcc
	/build/tools/winegcc/winegcc -o $@ --wine-objdir . --winebuild /build/tools/winebuild/winebuild -b \
  aarch64-w64-mingw32 -mno-cygwin -fasynchronous-unwind-tables -mconsole -municode \
  programs/arp/main.o dlls/winecrt0/libwinecrt0.a dlls/ucrtbase/libucrtbase.a \
  dlls/kernel32/libkernel32.a dlls/ntdll/libntdll.a $(LDFLAGS)
