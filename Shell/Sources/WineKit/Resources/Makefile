	/build/tools/winegcc/winegcc -o $@ --wine-objdir . --winebuild /build/tools/winebuild/winebuild -b \
  aarch64-w64-mingw32 -mno-cygwin -fasynchronous-unwind-tables dlls/qcap/tests/audiorecord.o \
  dlls/qcap/tests/avico.o dlls/qcap/tests/avimux.o dlls/qcap/tests/capturegraph.o \
  dlls/qcap/tests/filewriter.o dlls/qcap/tests/qcap.o dlls/qcap/tests/smartteefilter.o \
  dlls/qcap/tests/videocapture.o dlls/qcap/tests/testlist.o libs/strmbase/libstrmbase.a \
  libs/strmiids/libstrmiids.a libs/uuid/libuuid.a dlls/oleaut32/liboleaut32.a dlls/ole32/libole32.a \
  dlls/advapi32/libadvapi32.a dlls/msvfw32/libmsvfw32.a dlls/winecrt0/libwinecrt0.a \
  dlls/msvcrt/libmsvcrt.a dlls/kernel32/libkernel32.a dlls/ntdll/libntdll.a $(LDFLAGS)
