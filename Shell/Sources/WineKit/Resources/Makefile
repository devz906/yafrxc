  dlls/ntdsapi/tests/testlist.o dlls/ntdsapi/libntdsapi.a dlls/winecrt0/libwinecrt0.a \
  dlls/msvcrt/libmsvcrt.a dlls/kernel32/libkernel32.a dlls/ntdll/libntdll.a $(LDFLAGS)
