  include/guiddef.h include/msvcrt/string.h include/msvcrt/corecrt_malloc.h \
  include/msvcrt/corecrt_wstring.h include/winapifamily.h include/specstrings.h \
  include/driverspecs.h include/concurrencysal.h include/msvcrt/ctype.h \
  include/msvcrt/corecrt_wctype.h include/msvcrt/stddef.h include/msvcrt/intrin.h include/excpt.h \
  include/pshpack4.h include/poppack.h include/winnt.rh include/pshpack2.h include/pshpack8.h \
  include/pshpack1.h include/winbase.h include/winerror.h include/libloaderapi.h \
  include/processthreadsapi.h include/synchapi.h include/threadpoolapiset.h include/memoryapi.h \
  include/realtimeapiset.h include/namespaceapi.h include/timezoneapi.h include/winternl.h \
  include/ntdef.h include/wine/debug.h include/msvcrt/stdio.h include/msvcrt/corecrt_wstdio.h \
  include/msvcrt/corecrt_stdio_config.h include/wine/list.h include/wine/asm.h
