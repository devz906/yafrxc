  -DZ_SOLO -DPNG_ARM_NEON_OPT=0 -D__WINE_PE_BUILD -pipe -fcf-protection=none -fno-stack-protector \
  -fno-strict-aliasing -Wno-pragma-pack -gdwarf-4 -fasynchronous-unwind-tables $(CFLAGS)
