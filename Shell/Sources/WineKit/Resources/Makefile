  dlls/msvcp80/memory.o dlls/msvcp80/misc.o dlls/msvcp80/msvcp_main.o dlls/msvcp80/string.o \
  dlls/msvcp80/msvcp80.dll
dlls/msvcp90/details.o: dlls/msvcp90/details.c
	$(CC) -c -o $@ dlls/msvcp90/details.c -Idlls/msvcp90 -Iinclude -Iinclude/msvcrt -D_MSVCR_VER=90 \
  -D__WINESRC__ -D_MSVCP_VER=90 -D__WINE_PE_BUILD -Wall -pipe -fcf-protection=none \
  -fno-stack-protector -fno-strict-aliasing -Wdeclaration-after-statement -Wempty-body \
  -Wignored-qualifiers -Winit-self -Wno-pragma-pack -Wstrict-prototypes -Wtype-limits \
  -Wunused-but-set-parameter -Wvla -Wwrite-strings -Wpointer-arith -gdwarf-4 \
  -fasynchronous-unwind-tables $(CFLAGS)
