  -Wb,--prefer-native dlls/mssign32/mssign32_main.o dlls/winecrt0/libwinecrt0.a \
  dlls/ucrtbase/libucrtbase.a dlls/kernel32/libkernel32.a dlls/ntdll/libntdll.a $(LDFLAGS)
