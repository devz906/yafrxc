	$(CC) -c -o $@ dlls/mscms/tests/profile.c -Idlls/mscms/tests -Iinclude -Iinclude/msvcrt \
  -D_MSVCR_VER=0 -D__WINESRC__ -D__WINE_PE_BUILD -Wall -pipe -fcf-protection=none \
