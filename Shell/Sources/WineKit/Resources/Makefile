dlls/mscms/install dlls/mscms/install-dev:: dlls/mscms/libmscms.a
	tools/install-sh -m 644 $(INSTALL_DATA_FLAGS) dlls/mscms/libmscms.a $(DESTDIR)$(dlldir)/libmscms.a
