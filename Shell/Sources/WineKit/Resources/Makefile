  dlls/crypt32/libcrypt32.a dlls/advapi32/libadvapi32.a dlls/ws2_32/libws2_32.a \
  dlls/winecrt0/libwinecrt0.a dlls/msvcrt/libmsvcrt.a dlls/kernel32/libkernel32.a \
  dlls/ntdll/libntdll.a $(LDFLAGS)
