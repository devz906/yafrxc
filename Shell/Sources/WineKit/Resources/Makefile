  -D_MSVCR_VER=0 -D__WINESRC__ -D_CRTDLL -D_CRTIMP= -D__WINE_PE_BUILD -Wall -pipe \
  -fcf-protection=none -fno-stack-protector -fno-strict-aliasing -Wdeclaration-after-statement \
  -Wempty-body -Wignored-qualifiers -Winit-self -Wno-pragma-pack -Wstrict-prototypes -Wtype-limits \
  -Wunused-but-set-parameter -Wvla -Wwrite-strings -Wpointer-arith -gdwarf-4 \
  -fasynchronous-unwind-tables -fno-builtin $(CFLAGS)
