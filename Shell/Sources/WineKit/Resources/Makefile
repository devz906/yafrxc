dlls/vbscript/compile.o: dlls/vbscript/compile.c
	$(CC) -c -o $@ dlls/vbscript/compile.c -Idlls/vbscript -Iinclude -Iinclude/msvcrt -D_UCRT \
  -D__WINESRC__ -D__WINE_PE_BUILD -Wall -pipe -fcf-protection=none -fno-stack-protector \
  -fno-strict-aliasing -Wdeclaration-after-statement -Wempty-body -Wignored-qualifiers -Winit-self \
  -Wno-pragma-pack -Wstrict-prototypes -Wtype-limits -Wunused-but-set-parameter -Wvla \
  -Wwrite-strings -Wpointer-arith -gdwarf-4 -fasynchronous-unwind-tables $(CFLAGS)
